# Wiki.js Configuration
WIKI_API_URL=http://your-wikijs-instance.com
WIKI_API_KEY=your-wiki-api-key-here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-to-a-random-string-in-production

# To generate a password hash, run:
# node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 12).then(h => console.log(h))"

# Public site URL (required for Docker / reverse proxy setups)
SITE_URL=https://your-domain.com

# Redirect plain-HTTP requests to HTTPS from the app (308). Enable only if the
# reverse proxy sets X-Forwarded-Proto to the scheme the client used; doing the
# redirect in the reverse proxy itself is preferred.
HTTPS_REDIRECT=false

# Authentik SSO (optional - leave empty to disable)
# Create an OAuth2/OIDC provider in Authentik, then an Application linked to it.
# Add your redirect URIs in Authentik: https://your-domain.com/api/admin/auth/callback
# (and http://localhost:3000/api/admin/auth/callback for local dev)
AUTHENTIK_URL=https://auth.your-domain.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Only members of this Authentik group can access the admin. Leave empty to allow all authenticated users.
AUTHENTIK_ALLOWED_GROUP=portfolio-admins

# SMTP Configuration
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com
CONTACT_EMAIL=your-personal-email@your-domain.com
# Email to notify when a new comment is posted (defaults to CONTACT_EMAIL if not set)
COMMENT_NOTIFY_EMAIL=your-personal-email@your-domain.com

# OpenAI API Key (optional - for AI-powered auto-generation of tags, summary, SEO)
# Without this key, the local analysis mode will still work perfectly
OPENAI_API_KEY=

# Audience stats with a self-hosted Umami (optional, no cookie so no consent banner)
# URL the site's server uses to reach Umami (e.g. http://umami:3000 on the same Docker network)
UMAMI_URL=
# Website ID shown in Umami > Settings > Websites
UMAMI_WEBSITE_ID=

# GitHub auto-commit (optional - commits blog post changes to the repo)
# Create a fine-grained token with "Contents: Read and write" on your repo.
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo
GITHUB_BRANCH=main
