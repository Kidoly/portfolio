# Wiki.js Configuration
WIKI_API_URL=http://your-wikijs-instance.com
WIKI_API_KEY=your-wiki-api-key-here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-to-a-random-string-in-production

# To generate a password hash, run:
# node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 12).then(h => console.log(h))"

# SMTP Configuration
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com
CONTACT_EMAIL=your-personal-email@your-domain.com

# OpenAI API Key (optional - for AI-powered auto-generation of tags, summary, SEO)
# Without this key, the local analysis mode will still work perfectly
OPENAI_API_KEY=
